# ─────────────────────────────────────────────
# AgentWatch — Environment Configuration
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# Splunk Connection
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_HEC_PORT=8088
SPLUNK_HEC_TOKEN=your-hec-token-here
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=your-splunk-password
SPLUNK_INDEX=agentwatch

# Splunk AI / Foundation-Sec
SPLUNK_AI_ENDPOINT=https://your-splunk-host:8089/services/foundation_sec/v1
SPLUNK_AI_TOKEN=your-splunk-ai-token

# FastAPI Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WS_PORT=8001

# OpenTelemetry
OTEL_SERVICE_NAME=agentwatch-demo-agent
OTEL_EXPORTER=splunk_hec   # options: splunk_hec | console | otlp

# Demo Agent
OPENAI_API_KEY=your-openai-key-here   # used by demo LangGraph agent
DEMO_AGENT_MODE=normal                # options: normal | loop | hallucinate | drift

# Frontend
FRONTEND_PORT=3000
VITE_WS_URL=ws://localhost:8001/ws/agent-stream
VITE_API_URL=http://localhost:8000
